# 4) SymbolicConsciousnessEngine (Integration)
#
# - Minimal engine to show how memory, calibration, and layers can be wired
# - Accepts input symbols, queries memory, runs processing stack, updates calibration
###############################################################################


class SymbolicConsciousnessEngine:
    def __init__(
        self,
        memory: Optional[SQLiteSymbolicMemory] = None,  # Changed to SQLiteSymbolicMemory
        calibrator: Optional[DynamicThresholdCalibration] = None,
        processor: Optional[RecursiveCognitiveLayers] = None,
    ):
        self.memory = memory or SQLiteSymbolicMemory()  # Changed to SQLiteSymbolicMemory
        self.calibrator = calibrator or DynamicThresholdCalibration()
        self.processor = processor or RecursiveCognitiveLayers()
        # a simple history for debugging/training feedback
        self.history: deque = deque(maxlen=1000)

    def perceive(self, inputs: List[Any], context: Optional[Dict[str, Any]] = None) -> List[Tuple[Any, float]]:
        """
1. Query memory for immediate associations
2. Score inputs against resonance thresholds
3. Run recursive processing
4. Record and return results
"""
        context = context or {}
        now = time.time()

        # 1) Memory associations
        assoc_results = []
        for inp in inputs:
            assoc = self.memory.get_associations(inp, top_k=5)
            for sym, w in assoc:
                # weight combined with memory item strength and recency
                item = self.memory.retrieve(sym)
                item_strength = item.strength if item else 1.0
                score = float(w) * float(item_strength)
                assoc_results.append((sym, score))

        # 2) apply resonance threshold filtering
        filtered = []
        for sym, score in assoc_results:
            thr = self.calibrator.get_resonance(key=str(sym))
            if score >= thr:
                filtered.append((sym, min(1.0, score)))
            else:
                # Could still be kept as low-confidence candidate
                filtered.append((sym, float(score * 0.5)))

        # 3) feed into recursive processor (we only pass symbols)
        candidates = [s for (s, _) in filtered]
        processed = self.processor.run(candidates, context)

        # 4) combine confidences: prefer processor confidences, fallback to assoc score
        combined: Dict[Any, float] = {}
        assoc_map = {s: sc for s, sc in filtered}
        for s, conf in processed:
            combined[s] = max(combined.get(s, 0.0), conf) # Corrected merge logic
        for s, sc in filtered:
            combined.setdefault(s, sc)

        results = sorted(combined.items(), key=lambda x: -x[1])

        # record history for training/calibration
        self.history.append({
            "time": now,
            "inputs": inputs,
            "results": results,
            "context": context
        })
        return results

    def provide_feedback(self, observed: Any, expected: Any, reward: float = 1.0):
        """
Example feedback routine to update calibration and memory.
- observed: the symbol returned by engine
- expected: ground truth symbol ( or None)
"""
        success = (observed == expected)
        strength = 1.0
        # update calibrator
        self.calibrator.update_from_feedback(success=success, strength=strength, label=str(observed))
        # strengthen memory links for correct associations
        if success and expected is not None:
            self.memory.associate(observed, expected, weight=reward)
            self.memory.refresh(observed, boost=reward)
