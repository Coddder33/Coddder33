# 2) RecursiveCognitiveLayers
#
# - A small framework to stack/process symbolic nodes recursively
# - Each layer is a callable that takes input symbols and returns output symbols
# - Supports gating, depth limit, and early-exit by confidence
###############################################################################

class ProcessingLayer:
    """
A single processing layer abstraction around a callable.
The callable: fn(inputs: List[Any], context: dict) -> List[Tuple[symbol, confidence]]
"""

    def __init__(self, fn: Callable[[List[Any], Dict[str, Any]], List[Tuple[Any, float]]], name: str = None):
        self.fn = fn
        self.name = name or fn.__name__

    def process(self, inputs: List[Any], context: Dict[str, Any]) -> List[Tuple[Any, float]]:
        return self.fn(inputs, context)

class RecursiveCognitiveLayers:
    """
Manage and run a stack/graph of layers recursively/hierarchically.
- layers: ordered list applied per depth
- max_depth: prevents runaway recursion
- early_exit_confidence: if output confidence exceeds threshold, stop
"""

    def __init__(self, layers: Optional[List[ProcessingLayer]] = None, max_depth: int = 8, early_exit_confidence: float = 0.95):
        self.layers = layers or []
        self.max_depth = max_depth
        self.early_exit_confidence = early_exit_confidence

    def add_layer(self, layer: ProcessingLayer, position: Optional[int] = None):
        if position is None:
            self.layers.append(layer)
        else:
            self.layers.insert(position, layer)

    def run(self, inputs: List[Any], context: Optional[Dict[str, Any]] = None) -> List[Tuple[Any, float]]:
        context = context or {}
        def _recurse(current_inputs: List[Any], depth: int) -> List[Tuple[Any, float]]:
            if depth >= self.max_depth or not current_inputs:
                return []
            results: List[Tuple[Any, float]] = []
            for layer in self.layers:
                out = layer.process(current_inputs, context)  # list of (symbol, confidence)
                if not out:
                    continue
                # Collect and decide whether to pass recursively
                for sym, conf in out:
                    results.append((sym, conf))
                # If any result has high confidence, early exit
                if any(conf >= self.early_exit_confidence for (_, conf) in out):
                    return results
            # Prepare next inputs: symbols (ignoring confidences)
            next_inputs = [s for (s, _) in results]
            # Avoid infinite loops: deduplicate while preserving order
            seen = set()
            filtered = []
            for s in next_inputs:
                if s not in seen:
                    filtered.append(s)
                    seen.add(s)
            deeper = _recurse(filtered, depth + 1)
            # Merge results, prefer higher confidence for same symbol
            merged: Dict[Any, float] = {}
            for s, c in results + deeper:
                merged[s] = max(merged.get(s, 0.0), c)
            return sorted(merged.items(), key=lambda x: -x[1])
        return _recurse(inputs, 0)

