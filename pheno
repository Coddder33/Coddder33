# 1) DynamicThresholdCalibration
#
# - Keeps adaptive thresholds for numeric "resonance" and categorical "polarity"
# - Accepts performance feedback signals (e.g., reward, error)
# - Supports per-key thresholds and global fallback
###############################################################################

class DynamicThresholdCalibration:
    """
Adaptive threshold manager.
- resonance thresholds are floats (how strong a signal must be).
- polarity thresholds are dicts mapping labels to acceptance scores.
"""

    def __init__(
        self,
        initial_resonance: float = 0.5,
        initial_polarity: Optional[Dict[str, float]] = None,
        momentum: float = 0.9,
        min_resonance: float = 1e-4,
        max_resonance: float = 1.0,
    ):
        self.momentum = float(momentum)
        self.min_resonance = float(min_resonance)
        self.max_resonance = float(max_resonance)
        self.global_resonance = float(initial_resonance)
        self.resonance_per_key: Dict[str, float] = {}

        self.global_polarity = dict(initial_polarity or {})
        self.polarity_per_key: Dict[str, Dict[str, float]] = {}

    def get_resonance(self, key: Optional[str] = None) -> float:
        if key and key in self.resonance_per_key:
            return self.resonance_per_key[key]
        return self.global_resonance

    def get_polarity_threshold(self, label: str, key: Optional[str] = None) -> float:
        if key and key in self.polarity_per_key and label in self.polarity_per_key[key]:
            return self.polarity_per_key[key][label]
        return self.global_polarity.get(label, 0.5)

    def update_from_feedback(
        self,
        success: bool,
        strength: float,
        label: Optional[str] = None,
        key: Optional[str] = None,
        reward: Optional[float] = None,
    ):
        """
Update thresholds based on feedback.
- If success: relax threshold slightly (make detection easier).
- If failure: increase threshold if false positive, or decrease if false negative.
- strength: observed signal strength that triggered decision
- reward: optional scalar to scale update (+ve better, -ve worse)
"""
        r = float(reward) if reward is not None else (1.0 if success else -1.0)
        sign = 1.0 if success else -1.0

        # Resonance update: EMA towards observed strength scaled by feedback
        target = max(self.min_resonance, min(self.max_resonance, strength))
        alpha = 1.0 - self.momentum
        if key:
            current = self.resonance_per_key.get(key, self.global_resonance)
            new = (1 - alpha) * current + alpha * target * (1.0 - 0.5 * sign * (-r + 1))
            new = max(self.min_resonance, min(self.max_resonance, new))
            self.resonance_per_key[key] = new
        else:
            current = self.global_resonance
            new = (1 - alpha) * current + alpha * target * (1.0 - 0.5 * sign * (-r + 1))
            self.global_resonance = max(self.min_resonance, min(self.max_resonance, new))

        # Polarity update if label present: adjust acceptance probability
        if label:
            if key:
                polmap = self.polarity_per_key.setdefault(key, dict(self.global_polarity))
            else:
                polmap = self.global_polarity
            current_p = polmap.get(label, 0.5)
            # Move polarity toward 1.0 on success, 0.0 on failure, scaled by |reward|
            adjust = (0.2 * (r if r >= 0 else r)) * (1.0 if success else -1.0)
            new_p = current_p + (1 - self.momentum) * adjust
            polmap[label] = max(0.0, min(1.0, new_p))

